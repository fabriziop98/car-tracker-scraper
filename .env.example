# Copiar a .env (gitignored) y completar con los valores reales.
# NUNCA commitear .env con valores reales.

# Redis para el token bucket / circuit breaker (el mismo que ya levanta
# el docker-compose del repo car-tracker)
ANTIBLOCK_REDIS_URL=redis://localhost:6379/0

# Bot de Telegram para alertas del circuit breaker (ver BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Proxies datacenter, coma-separados (host:port o user:pass@host:port).
# Vacio = sin proxy (default hasta contratar un proveedor).
ANTIBLOCK_PROXY_LIST=

# Landing zone: S3/MinIO para el raw crudo (wdxtkg30nm). Defaults ya
# apuntan al MinIO que levanta el docker-compose del repo car-tracker.
LANDING_S3_ENDPOINT_URL=http://localhost:9000
LANDING_S3_ACCESS_KEY=car_tracker
LANDING_S3_SECRET_KEY=car_tracker_minio
LANDING_S3_BUCKET=car-tracker-raw
